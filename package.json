{
  "name": "jitar-plugins",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "repository": {
    "url": "git+https://github.com/MaskingTechnology/jitar-plugins.git"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "review": "npm run review --workspaces",
    "publish": "npm publish --workspaces",
    "version": "npm version $VERSION --no-git-tag-version --workspaces --include-workspace-root=true",
    "link": "npm run link --workspaces",
    "link-deps": "npm link jitar @theshelf/authentication @theshelf/database @theshelf/events @theshelf/files @theshelf/notification"
  },
  "workspaces": [
    "packages/**/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.4",
    "rimraf": "^6.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">= 22.9.0"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
